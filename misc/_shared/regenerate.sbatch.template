#!/bin/bash
# Generic ETH Euler regeneration launcher for a GCMagicc release bundle.
# See gcm_sequence/EULER.md for the authoritative operational reference.
#
# Usage (edit the marked lines, then submit):
#   scp -q -r <bundle>/code euler:/cluster/home/nicolai/gcm_release/<bundle>/
#   sbatch regenerate.sbatch.template
#
#SBATCH --ntasks=1 --cpus-per-task=8 --mem-per-cpu=28G
#SBATCH --gpus=nvidia_geforce_rtx_4090:1 --time=24:00:00
#SBATCH --output=/cluster/scratch/nicolai/gcm_runs/gcm_release_%j.slurm.log
# (do NOT set --partition; SLURM auto-routes to gpuhe.120h)

set -euo pipefail
module load stack/2024-06 python_cuda/3.11.6 eth_proxy

BUNDLE_DIR="/cluster/home/nicolai/gcm_release/NIC-XS"   # <-- EDIT: which bundle
# Point at the current normalized data + checkpoints (land bulk data in work/math,
# NOT scratch, per EULER.md):
export DATA_DIR="/cluster/work/math/nicolai/normalized_7Augext"   # <-- EDIT
export MODEL_BASE="$BUNDLE_DIR/checkpoints/modelsNfour_7Augext_miss585_nosmooth"  # <-- EDIT per bundle
export DEVICE="cuda:0"

cd "$BUNDLE_DIR"
bash run.sh

# To chain a downstream step after this finishes:
#   jid=$(sbatch --parsable regenerate.sbatch.template)
#   sbatch --dependency=afterok:$jid <next>.sbatch
