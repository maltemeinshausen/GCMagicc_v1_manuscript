#!/bin/bash
# Generic ETH Euler regeneration launcher for a GCMagicc release bundle.
# See gcm_sequence/EULER.md for the authoritative operational reference.
#
# Usage (set the release paths, then submit):
#   export BUNDLE_DIR=/path/to/NIC-XS
#   export DATA_DIR=/path/to/normalized_7Augext
#   sbatch regenerate.sbatch.template
#
#SBATCH --ntasks=1 --cpus-per-task=8 --mem-per-cpu=28G
#SBATCH --gpus=nvidia_geforce_rtx_4090:1 --time=24:00:00
#SBATCH --output=gcm_release_%j.slurm.log
# (do NOT set --partition; SLURM auto-routes to gpuhe.120h)

set -euo pipefail
module load stack/2024-06 python_cuda/3.11.6 eth_proxy

: "${BUNDLE_DIR:?set BUNDLE_DIR to the extracted NIC release bundle}"
: "${DATA_DIR:?set DATA_DIR to the normalized input directory}"
export MODEL_BASE="${MODEL_BASE:-$BUNDLE_DIR/checkpoints/modelsNfour_7Augext_miss585_nosmooth}"
export DEVICE="cuda:0"

cd "$BUNDLE_DIR"
bash run.sh

# To chain a downstream step after this finishes:
#   jid=$(sbatch --parsable regenerate.sbatch.template)
#   sbatch --dependency=afterok:$jid <next>.sbatch
